# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ===== Node =====
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-store/

# ===== 模型权重（体积大，不入库，见 models/README.md）=====
models/*.pt
models/*.onnx
models/*.engine
models/*.pth
!models/README.md

# ===== 运行期数据（数据库 / 上传 / 截图 / 本地测试图）=====
# testshots 下只有 single/ 入库：它是演示页「用示例图」、嵌入页示例、
# test_api_m3/m4 共同依赖的 30 张手势样例（932KB）。
# 其余（tiles 拼图 4.5MB、samples.jpg、user 个人素材）属于本地素材，不入库。
data/testshots/*
!data/testshots/single/
!data/testshots/single/*.jpg
data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite3
data/.jwt_secret
data/uploads/*
data/screenshots/*
!data/uploads/.gitkeep
!data/screenshots/.gitkeep

# ===== 环境变量与密钥 =====
.env
.env.*
!.env.example
*.key
secrets.json

# ===== 工具本地数据 =====
.workbuddy/

# ===== IDE / 系统 =====
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# ===== 构建产物 =====
dist/
build/
*.log
