# 统一换行符：仓库内一律 LF
* text=auto eol=lf

*.py   text eol=lf
*.js   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.sh   text eol=lf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制文件不做换行符转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pt   binary
*.onnx binary
*.pth  binary
*.db   binary
*.sqlite3 binary
