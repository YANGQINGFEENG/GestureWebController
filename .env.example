# 环境变量示例：复制成 .env 后按需填写（.env 已在 .gitignore 里，不会入库）
#
# 注意：本项目不自动读取 .env，需要在启动前 export / set。
# Windows PowerShell 示例：
#   $env:GWC_LLM_API_KEY = "sk-xxx"; python scripts/start_dev.py
# Git Bash 示例：
#   GWC_LLM_API_KEY=sk-xxx python scripts/start_dev.py

# ---------- 数据库 ----------
GWC_DB_URL=sqlite:///data/app.db
# 0 = 关闭数据库：手势操控照常，记录不落库（演示降级用）
GWC_DB_ENABLED=1
GWC_RECORDS_ENABLED=1

# ---------- 鉴权 ----------
# 留空则首次启动自动生成到 data/.jwt_secret；多机部署必须显式设置同一个值
GWC_JWT_SECRET=
# 首次启动自动创建的管理员（库为空时才种）
GWC_ADMIN_USER=admin
GWC_ADMIN_PASSWORD=admin123456
GWC_ALLOW_REGISTER=1

# ---------- 上传 ----------
GWC_UPLOAD_ENABLED=1
GWC_UPLOAD_DIR=data/uploads

# ---------- 运行 ----------
# 1 = 启动即加载模型（演示前先跑一遍，避免首次识别慢 3 秒）
GWC_PRELOAD=1
GWC_LOG_LEVEL=INFO

# ---------- AI 问答（M3-5） ----------
# mock = 离线规则回答（默认，断网也能答辩演示）
# openai = 任何 OpenAI 兼容接口，改 base_url + model 即可换厂商
GWC_LLM_PROVIDER=mock
# 留空则自动回退到 mock，不会报错
GWC_LLM_API_KEY=
# DeepSeek 示例；OpenAI 用 https://api.openai.com/v1；本地 Ollama 用 http://127.0.0.1:11434/v1
GWC_LLM_BASE_URL=https://api.deepseek.com/v1
GWC_LLM_MODEL=deepseek-chat
